# Regular OpenRouter API key (GET /key + GET /credits)
OPEN_ROUTER_API_KEY=sk-or-v1-your-key-here
OPEN_ROUTER_API_KEY_NAME=b

# Required to list every key on the account with dashboard names
# (b, sn34-1, sn34-2). Create at https://openrouter.ai/settings/management-keys
OPENROUTER_MANAGEMENT_API_KEY=

# Optional: extra named keys if you do not have a management key
# OPENROUTER_KEYS=sn34-1=sk-or-v1-aaa,sn34-2=sk-or-v1-bbb
